<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f6f2">
    <title>Katalog Produk | CS Bot</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/app.js" defer></script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="CS Bot, beranda">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>CS Bot</span>
      </a>
      <span class="topbar-note">Toko online</span>
    </header>

    <main class="page-layout">
      <section class="catalog" aria-labelledby="catalog-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">KATALOG</p>
            <h1 id="catalog-title">Produk pilihan</h1>
          </div>
          <span id="product-count" class="product-count">Memuat produk...</span>
        </div>
        <p id="product-status" class="notice" role="status" hidden></p>
        <div id="product-list" class="product-list" aria-live="polite"></div>
      </section>

      <aside class="chat-panel" aria-labelledby="chat-title">
        <div class="chat-heading">
          <div class="agent-mark" aria-hidden="true">CS</div>
          <div>
            <h2 id="chat-title">Tanya CS</h2>
            <p><span class="online-dot" aria-hidden="true"></span> Siap membantu</p>
          </div>
        </div>
        <div id="chat-messages" class="chat-messages" aria-live="polite" aria-relevant="additions">
          <p class="chat-bubble chat-bubble--agent">Halo! Ada yang ingin ditanyakan soal produk?</p>
        </div>
        <form id="chat-form" class="chat-form">
          <label class="visually-hidden" for="chat-input">Pesan untuk CS</label>
          <textarea id="chat-input" name="message" rows="2" maxlength="500" placeholder="Tulis pertanyaan..." required></textarea>
          <div class="chat-form-footer">
            <span id="chat-status" class="chat-status" role="status"></span>
            <button type="submit" aria-label="Kirim pesan">Kirim <span aria-hidden="true">&rarr;</span></button>
          </div>
        </form>
      </aside>
    </main>
  </body>
</html>