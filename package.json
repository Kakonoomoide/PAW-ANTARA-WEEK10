{
  "name": "cs-bot-api",
  "version": "1.0.0",
  "description": "AI Customer Service app - Gemini + Express + Sequelize with EJS user views",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node seeders/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^7.0.2",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
